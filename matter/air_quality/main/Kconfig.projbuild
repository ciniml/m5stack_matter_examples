menu "Air Quality Sensor Unit Configuration"

    config I2C_SCAN_ENABLE
        bool "Enable I2C bus scanning on startup"
        default n
        help
            Enable scanning of I2C bus to detect connected devices.
            This is useful for debugging but may slow down startup.

    config I2C_DEVICE_PROBE_ENABLE
        bool "Enable I2C device probe before sensor initialization"
        default n
        help
            Enable probing of specific I2C devices before sensor initialization.
            This helps with debugging sensor detection issues but adds overhead.

    config EPD_UPDATE_INTERVAL_SEC
        int "EPD display update interval in seconds"
        range 10 300
        default 30
        help
            Interval for updating the EPD display with sensor data.
            Longer intervals help extend EPD lifetime.
            Range: 10-300 seconds, Default: 30 seconds.

endmenu
